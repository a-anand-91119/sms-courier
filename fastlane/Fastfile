# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

opt_out_usage

default_platform(:android)

platform :android do
  # ==================== TESTING ====================

  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  # ==================== VERSIONING ====================

  desc "Increment version code"
  lane :increment_vc do
    increment_version_code(
      gradle_file_path: "./app/build.gradle",
    )
  end

  # ==================== BUILDING ====================

  desc "Create and sign a new build"
  lane :build do
    gradle(tasks: ["clean", "assembleRelease", "bundleRelease"])
  end

  desc "Build debug APK and test APK for screenshots"
  lane :build_for_screenshots do
    gradle(tasks: ["assembleDebug", "assembleDebugAndroidTest"])
  end

  # ==================== SCREENSHOTS ====================

  desc "Capture screenshots using an emulator"
  lane :screenshots do
    build_for_screenshots
    screengrab
  end

  # ==================== METADATA ====================

  desc "Generate changelog from git commits"
  lane :generate_changelog do |options|
    version_code = options[:version_code] || ENV["VERSION_CODE"] || "1"

    # Ensure version_code is not empty
    if version_code.to_s.strip.empty?
      UI.user_error!("version_code cannot be empty. Please provide version_code parameter or set VERSION_CODE environment variable.")
    end

    changelog = changelog_from_git_commits(
      commits_count: 20,
      pretty: "- %s",
      merge_commit_filtering: "exclude_merges"
    )

    # Write changelog for specific version
    changelogs_dir = "fastlane/metadata/android/en-US/changelogs"
    FileUtils.mkdir_p(changelogs_dir) unless Dir.exist?(changelogs_dir)

    changelog_path = "#{changelogs_dir}/#{version_code}.txt"
    File.write(changelog_path, changelog)

    UI.success("Changelog written to #{changelog_path}")
  end

  desc "Upload only metadata (descriptions, changelogs) to Play Store"
  lane :upload_metadata do
    upload_to_play_store(
      track: "internal",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload only screenshots to Play Store"
  lane :upload_screenshots do
    upload_to_play_store(
      track: "internal",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end

  desc "Upload all store assets (metadata + screenshots) to Play Store"
  lane :upload_store_assets do
    upload_to_play_store(
      track: "internal",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_changelogs: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end

  # ==================== DEPLOYMENT ====================

  desc "Submit a new Beta Build to Crashlytics Beta"
  lane :beta do
    gradle(task: "clean assembleRelease")
    crashlytics
  end

  desc "Submit a new Internal Build to Play Store"
  lane :internal do
    gradle(task: "clean assembleRelease bundleRelease")
    upload_to_play_store(
      track: "internal",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Submit internal build with metadata and changelog"
  lane :internal_with_metadata do |options|
    version_code = options[:version_code] || ENV["VERSION_CODE"] || "1"

    # Generate changelog from git commits
    generate_changelog(version_code: version_code)

    # Build and upload
    gradle(task: "clean assembleRelease bundleRelease")
    upload_to_play_store(
      track: "internal",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: false,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  # ==================== PROMOTIONS ====================

  desc "Promote Internal to Alpha"
  lane :promote_internal_to_alpha do
    upload_to_play_store(track: "internal", track_promote_to: "alpha")
  end

  desc "Promote Alpha to Beta"
  lane :promote_alpha_to_beta do
    upload_to_play_store(track: "alpha", track_promote_to: "beta")
  end

  desc "Promote Beta to Production"
  lane :promote_beta_to_production do
    upload_to_play_store(track: "beta", track_promote_to: "production")
  end

  # ==================== FULL PIPELINES ====================

  desc "Full release: test, build, and deploy to internal track with metadata"
  lane :full_release do |options|
    version_code = options[:version_code] || ENV["VERSION_CODE"] || "1"

    test
    generate_changelog(version_code: version_code)
    build

    upload_to_play_store(
      track: "internal",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: false,
      skip_upload_changelogs: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end

  desc "Deploy a new version to Google Play Production"
  lane :deploy do
    gradle(task: "clean assembleRelease bundleRelease")
    upload_to_play_store(
      track: "production",
      aab: "app/build/outputs/bundle/release/app-release.aab"
    )
  end
end
